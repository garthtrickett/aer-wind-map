# Server only. Never use VITE_ names for bot credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PUBLIC_APP_URL=https://aer-wind-map-production.up.railway.app
# Mount a durable Railway volume at /data before enabling the bot.
AER_ALERT_DB=/data/aer-alerts.sqlite

# Browser-visible MapTiler key for satellite imagery and place-name search.
# Restrict this key to the app's domain in MapTiler. No bot/server secrets here.
# Set in Railway build variables and redeploy, or .env.local for development.
VITE_MAPTILER_API_KEY=

# Enable only after confirming an appropriate Esri licence for public display.
# Esri Wayback service access being anonymous does not grant redistribution rights.
VITE_ESRI_WAYBACK_ENABLED=false
