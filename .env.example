# Server only. Never use VITE_ names for bot credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PUBLIC_APP_URL=https://aer-wind-map-production.up.railway.app
# Mount a durable Railway volume at /data before enabling the bot.
AER_ALERT_DB=/data/aer-alerts.sqlite

# Email accounts and all saved spots. Use the same durable /data volume.
# RAILWAY_VOLUME_MOUNT_PATH also supplies this default automatically on Railway.
AER_ACCOUNT_DB=/data/aer-accounts.sqlite
# Server-only Resend credentials; verify the sending domain in Resend first.
RESEND_API_KEY=
AER_EMAIL_FROM=Aer <login@your-verified-domain.example>

# Browser-visible MapTiler key for satellite imagery and place-name search.
# Restrict this key to the app's domain in MapTiler. No bot/server secrets here.
# Set in Railway build variables and redeploy, or .env.local for development.
VITE_MAPTILER_API_KEY=

# Enable only after confirming an appropriate Esri licence for public display.
# Esri Wayback service access being anonymous does not grant redistribution rights.
VITE_ESRI_WAYBACK_ENABLED=false

# Optional direct ECMWF ECWAM CY50R1 research hindcast archive, server only.
# Registered ECMWF Web API credentials (not the CDS API key).
ECMWF_API_EMAIL=
ECMWF_API_KEY=
# Defaults to /data/aer-wave-history.sqlite on the Railway persistent volume.
# Local development requires an absolute path to enable caching.
AER_WAVE_HISTORY_DB=
# Limits count only newly queued months; cached/pending months are reused.
# 512 months allows ten complete 2022–2025 locations (49 UTC months each).
AER_ARCHIVE_DAILY_MONTH_LIMIT=512
AER_ARCHIVE_PENDING_MONTH_LIMIT=2048
